# Measurement ID de la propiedad GA4 (ALS-023, ADR-15). Formato "G-XXXXXXXXXX".
# Sin este valor la analítica queda deshabilitada en silencio (mismo criterio
# que el placeholder de WhatsApp, ver src/shared/constants/whatsapp.ts) — no
# rompe el build ni manda eventos a una propiedad que no existe.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Function URL de la Lambda del catálogo de Spotify (ALS-026, ADR-11) —
# pública por diseño, no es un secreto. Ver aws/spotify-catalog/README.md
# para el registro real del despliegue. Sin este valor, la sección
# Discografía (ALS-044) degrada a su fallback en vez de romperse.
VITE_SPOTIFY_CATALOG_URL=https://i4vptq5uyekm6tcy7sto6awwei0ifxep.lambda-url.us-east-2.on.aws/

# Function URL de la Lambda del catálogo de YouTube (ALS-027, ADR-11) —
# pública por diseño, no es un secreto. Ver aws/youtube-catalog/README.md
# para el registro real del despliegue. Sin este valor, la sección Video
# (ALS-045) degrada a su fallback en vez de romperse.
VITE_YOUTUBE_CATALOG_URL=https://rmtwnmstkfe6yn7e4jyj3zgeym0tjufw.lambda-url.us-east-2.on.aws/
